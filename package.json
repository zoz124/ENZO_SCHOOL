{
  "name": "figma-make-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "payload build",
    "start": "next start",
    "format": "oxfmt",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.8",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.8",
    "@payloadcms/plugin-mcp": "4.0.0-beta.8",
    "@payloadcms/richtext-lexical": "4.0.0-beta.8",
    "@payloadcms/translations": "4.0.0-beta.8",
    "@payloadcms/ui": "4.0.0-beta.8",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "payload": "4.0.0-beta.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4",
    "@payloadcms/db-postgres": "4.0.0-beta.8",
    "@payloadcms/db-sqlite": "^4.0.0-beta.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.22.3",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
